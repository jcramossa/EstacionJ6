        OM[API Abierta Open-Meteo]
    end

    subgraph App["WeatherRepository"]
        GetLoc[getLocation]
        GetCity[getCityName]
        Fetch[fetchWeather]
        WMO[Decodificador Códigos WMO]
        Wind[Calculador Rosa de los Vientos]
    end

    LocMgr --> GetLoc
    GetLoc --> Geo
    Geo --> GetCity
    GetLoc -->|Latitud & Longitud| Fetch
